# ---------- 服务基础配置 ----------
PORT=8000
FRONTEND_URL=http://localhost:5173
# 单次音频上传体积上限（字节），默认 20MB
UPLOAD_MAX_BYTES=20971520

# ---------- JWT 认证（成员C 后台基石模块）----------
# JWT 签名密钥，生产环境务必替换为高强度随机字符串（至少 32 字节）
JWT_SECRET=scenic-ai-dev-secret-change-in-production-2026
# Token 有效期，支持 N 数字或 7d / 24h / 60m 等后缀
JWT_EXPIRES_IN=7d

# ---------- 问答大模型（成员B / 数据洞察模块）----------
# DashScope / 阿里云百炼 API Key（https://bailian.console.aliyun.com/）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-plus

# ---------- ASR 语音识别（成员A 多模态交互引擎）----------
# 提供方：mock 离线桩 | whisper-api 远程接口 | whisper-cli 本地 Whisper 可执行程序
ASR_PROVIDER=mock
ASR_LANGUAGE=zh
ASR_TIMEOUT_MS=30000
# mock 提供方返回的固定文本
ASR_MOCK_TEXT=西湖景区有哪些值得游览的景点？
# whisper-api：OpenAI 兼容接口，可换成硅基流动 / 阿里云百炼 等国内可访问的 /v1 地址
WHISPER_API_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# whisper-cli：本地可执行程序与其参数模板，{audio} 会被替换为临时 WAV 路径
# 默认脚本基于 faster-whisper（pip install faster-whisper），无需 C++ 编译工具链
ASR_CLI_BIN=python
ASR_CLI_ARGS=scripts/whisper_transcribe.py --audio {audio} --model small

# ---------- TTS 语音合成（成员A 多模态交互引擎）----------
# 提供方：edge 微软 Edge 在线合成（需 pip install edge-tts）| mock 离线模拟合成
TTS_PROVIDER=edge
# 已安装 edge-tts 的 Python 解释器路径（Windows 下也可写成绝对路径）
TTS_PYTHON=python
# edge 合成脚本路径，默认 backend/scripts/edge_tts_stream.py
TTS_EDGE_SCRIPT=
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
# mock 提供方的采样率
TTS_MOCK_SAMPLE_RATE=24000

# ---------- 知识库（成员C 知识库管理模块）----------
# 向量库：留空则使用进程内内存向量库（本地联调用），部署时填 Qdrant 地址
QDRANT_URL=

# 向量服务（OpenAI 兼容接口）：留空则使用本地确定性伪向量
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# ---------- 统一身份认证（成员C）----------
# 默认全部为 mock 演示模式：无需任何外部资质即可跑通四种登录方式
# 邮件验证码：mock 不回真信（验证码直接回显页面）；smtp 接入真实邮件服务
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@scenic-ai.local
EMAIL_CODE_TTL=300
EMAIL_CODE_COOLDOWN=60
# 演示用：mock 模式把验证码回传给前端；生产务必改为 false
EMAIL_EXPOSE_CODE=true

# 微信扫码登录：mock 为本地模拟二维码；real 需微信开放平台网站应用资质
WECHAT_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_QR_TTL=120

# 统一认证平台（学校 CAS / OAuth2 等）：mock 本地模拟；real 需对方提供地址与 clientId
SSO_MODE=mock
SSO_ENDPOINT=
SSO_CLIENT_ID=

# 数字证书登录：mock 校验文件与指纹；ca 需配置 CA 根证书做真实验签
CERT_MODE=mock
CA_CERT_PATH=

# ---------- MySQL 物理数据库（任务3 各组表持久化）----------
# 建模脚本见 backend/sql/01_schema.sql（MySQL Workbench 可直接 Forward Engineer）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scenic_ai
