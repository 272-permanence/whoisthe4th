# ---------- 服务基础配置 ----------
PORT=8000
FRONTEND_URL=http://localhost:5173
# 单次音频上传体积上限（字节），默认 20MB
UPLOAD_MAX_BYTES=20971520

# ---------- JWT 认证（成员C 后台基石模块）----------
JWT_SECRET=scenic-ai-dev-secret-change-in-production-2026
JWT_EXPIRES_IN=7d

# ---------- 问答大模型（成员B）----------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-plus

# ---------- ASR 语音识别（成员A）----------
ASR_PROVIDER=mock
ASR_LANGUAGE=zh
ASR_TIMEOUT_MS=30000
ASR_MOCK_TEXT=西湖景区有哪些值得游览的景点？
WHISPER_API_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
ASR_CLI_BIN=python
ASR_CLI_ARGS=scripts/whisper_transcribe.py --audio {audio} --model small

# ---------- TTS 语音合成（成员A）----------
TTS_PROVIDER=edge
TTS_PYTHON=python
TTS_EDGE_SCRIPT=
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
TTS_MOCK_SAMPLE_RATE=24000

# ---------- 知识库（成员C）----------
QDRANT_URL=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# ---------- MySQL 读写分离（全组统一配置 · 成员D 牵头）----------
# 本地没做主从时，把 master 和 slave 都配成同一端口 = 自动降级为单库
# 建表脚本见 backend/sql/01_schema_mysql55.sql（MySQL Workbench Forward Engineer）
DB_NAME=scenic_ai
DB_USER=root
DB_PASSWORD=
DB_MASTER_HOST=127.0.0.1
DB_MASTER_PORT=3307
DB_SLAVE_HOST=127.0.0.1
DB_SLAVE_PORT=3307

# ---------- 高德地图（成员B）----------
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=

# ---------- Redis 消息队列（成员D · 数据洞察）----------
# 日志：业务侧投递到 Stream，消费者组异步落库，业务响应不被日志写入拖慢
# 大屏：统计结果走 Pub/Sub 广播，Tomcat 多节点部署时各节点都能推给本机 SSE 客户端
# Windows 可安装 Memurai（Redis 7 兼容）或 Docker 运行 redis:7；REDIS_ENABLED=false 可整体关闭
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_LOG_STREAM=scenic:log:stream
REDIS_LOG_GROUP=log-writer
REDIS_STATS_CHANNEL=scenic:stats
REDIS_STATS_LOCK_KEY=scenic:stats:pusher
