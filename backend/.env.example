# ---------- 服务基础配置 ----------
PORT=8000
FRONTEND_URL=http://localhost:5173
# 单次音频上传体积上限（字节），默认 20MB
UPLOAD_MAX_BYTES=20971520

# ---------- 问答大模型（成员B / 数据洞察模块）----------
# DashScope / 阿里云百炼 API Key（https://bailian.console.aliyun.com/）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-plus

# ---------- ASR 语音识别（成员A 多模态交互引擎）----------
# 提供方：mock 离线桩 | whisper-api 远程接口 | whisper-cli 本地 Whisper 可执行程序
ASR_PROVIDER=mock
ASR_LANGUAGE=zh
ASR_TIMEOUT_MS=30000
# mock 提供方返回的固定文本
ASR_MOCK_TEXT=西湖景区有哪些值得游览的景点？
# whisper-api：OpenAI 兼容接口，可换成硅基流动 / 阿里云百炼 等国内可访问的 /v1 地址
WHISPER_API_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# whisper-cli：本地可执行程序与其参数模板，{audio} 会被替换为临时 WAV 路径
# 默认脚本基于 faster-whisper（pip install faster-whisper），无需 C++ 编译工具链
ASR_CLI_BIN=python
ASR_CLI_ARGS=scripts/whisper_transcribe.py --audio {audio} --model small

# ---------- TTS 语音合成（成员A 多模态交互引擎）----------
# 提供方：edge 微软 Edge 在线合成（需 pip install edge-tts）| mock 离线模拟合成
TTS_PROVIDER=edge
# 已安装 edge-tts 的 Python 解释器路径（Windows 下也可写成绝对路径）
TTS_PYTHON=python
# edge 合成脚本路径，默认 backend/scripts/edge_tts_stream.py
TTS_EDGE_SCRIPT=
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
# mock 提供方的采样率
TTS_MOCK_SAMPLE_RATE=24000

# ---------- 知识库（成员C 知识库管理模块）----------
# 向量库：留空则使用进程内内存向量库（本地联调用），部署时填 Qdrant 地址
QDRANT_URL=

# 向量服务（OpenAI 兼容接口）：留空则使用本地确定性伪向量
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# ---------- MySQL 物理数据库（成员B / 任务3 各组表持久化）----------
# 建模脚本见 backend/sql/01_schema.sql（MySQL Workbench 可直接 Forward Engineer）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scenic_ai

# ---------- MySQL 读写分离（成员D · 数据洞察模块）----------
# master 负责写、slave 负责读，主从复制由 MySQL 层保证
DB_MASTER_HOST=127.0.0.1
DB_MASTER_PORT=3307
DB_SLAVE_HOST=127.0.0.1
DB_SLAVE_PORT=3308
